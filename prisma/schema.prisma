generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Джоб-борд. Совпадает с `JobBoardId` в `src/providers/types.ts`.
enum JobBoardProvider {
  hh
  linkedin
}

model Vacancy {
  /// Внутренний ключ. FK analyses/applications ссылаются сюда, не на id борда.
  id          String           @id @default(cuid())
  provider    JobBoardProvider
  /// Id вакансии у провайдера (hh.ru /vacancy/{id}, LinkedIn /jobs/view/{id}).
  externalId  String           @map("external_id")
  title       String
  company     String?
  salary      String?
  url         String
  description String?          @db.Text
  publishedAt DateTime?        @map("published_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  analyses     Analysis[]     @relation("VacancyAnalyses")
  applications Application[]  @relation("VacancyApplications")

  @@unique([provider, externalId], map: "vacancies_provider_external_id_key")
  @@index([provider], map: "vacancies_provider_idx")
  @@map("vacancies")
}

model Analysis {
  id            String   @id @default(cuid())
  vacancyId     String   @map("vacancy_id")
  vacancy       Vacancy  @relation("VacancyAnalyses", fields: [vacancyId], references: [id], onDelete: Cascade)
  score         Int
  summary       String?  @db.Text
  pros          Json?
  cons          Json?
  applyDecision Boolean? @map("apply_decision")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([vacancyId])
  @@index([score])
  @@map("analyses")
}

model Application {
  id          String    @id @default(cuid())
  vacancyId   String    @map("vacancy_id")
  vacancy     Vacancy   @relation("VacancyApplications", fields: [vacancyId], references: [id], onDelete: Cascade)
  status      String
  coverLetter String?   @map("cover_letter") @db.Text
  appliedAt   DateTime? @map("applied_at")
  response    String?   @db.Text

  @@index([vacancyId])
  @@index([status])
  @@map("applications")
}
